# Copy to `.env` for local development:  cp .env.example .env
# `.env` is git-ignored. NEVER commit real tokens.
#
# The same variables are set in production in Cloudflare Pages →
# Settings → Variables and Secrets (see README → "Lead form setup").

# ---------------------------------------------------------------------------
# 1) PUBLIC build-time values — baked into the browser bundle by `npm run env`.
#    Safe to expose. On Cloudflare Pages add them as plain-text BUILD variables.
# ---------------------------------------------------------------------------

# Cloudflare Turnstile SITE key (public). Empty = Cloudflare's test key
# 1x00000000000000000000AA, which always passes (fine for local dev only).
TURNSTILE_SITE_KEY=

# Production origin, no trailing slash. Used for canonical/hreflang/sitemap (stage 6).
SITE_URL=https://mangotour.example

# ---------------------------------------------------------------------------
# 2) SERVER-ONLY secrets — read by the Pages Function functions/api/lead.ts.
#    `wrangler pages dev` (npm run dev:functions) loads them from this file.
#    On Cloudflare Pages add them as encrypted SECRETS, never as build variables.
# ---------------------------------------------------------------------------

# Bot token from @BotFather, e.g. 1234567890:AAH...
TELEGRAM_BOT_TOKEN=

# Chat that receives leads: your user id, a group id (-100…) or a channel id.
TELEGRAM_CHAT_ID=

# Turnstile SECRET key. Test secret that always passes: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ---------------------------------------------------------------------------
# 3) KV binding LEAD_RATE_LIMIT (per-IP rate limit) is NOT an env variable:
#    locally `npm run dev:functions` creates an in-memory one (--kv flag);
#    in production bind a KV namespace in Pages → Settings → Bindings.
# ---------------------------------------------------------------------------

# Optional, LOCAL TESTING ONLY: send Telegram / Turnstile calls to a mock server.
# TELEGRAM_API_BASE=http://127.0.0.1:9911
# TURNSTILE_VERIFY_URL=http://127.0.0.1:9911/siteverify
