{
  "name": "mango-tour",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && node scripts/postbuild.mjs",
    "build:dev": "ng build --configuration development",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false && npm run test:functions",
    "test:watch": "ng test",
    "brand": "node scripts/brand.mjs",
    "images": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/images.mjs",
    "prebuild": "npm run env && npm run images",
    "prestart": "npm run env && npm run images",
    "env": "node --env-file-if-exists=.env scripts/env.mjs",
    "pretest": "npm run env && npm run images",
    "test:functions": "tsc -p functions/tsconfig.json && vitest run --config functions/vitest.config.mts",
    "dev:functions": "wrangler pages dev dist/mango-tour/browser --kv LEAD_RATE_LIMIT --port 8788"
  },
  "private": true,
  "packageManager": "npm@10.9.9",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.7",
    "@fontsource-variable/manrope": "^5.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.0",
    "@cloudflare/workers-types": "^5.20261116.1",
    "@types/node": "^22.12.0",
    "axe-core": "^4.14.1",
    "jsdom": "^30.0.0",
    "png-to-ico": "^3.0.2",
    "prettier": "^3.8.1",
    "sharp": "^0.35.5",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.163.0"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
