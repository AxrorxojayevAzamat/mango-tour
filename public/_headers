# Cloudflare Pages response headers. https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# Angular bundles and fonts have content hashes in their names: cache forever.
/*.js
  Cache-Control: public, max-age=31536000, immutable
/*.css
  Cache-Control: public, max-age=31536000, immutable
/media/*
  Cache-Control: public, max-age=31536000, immutable

# Photos are always requested with a content-hash query (?v=…, see image-loader.ts):
# a replaced photo gets a new URL, so they can be cached forever too.
/images/*
  Cache-Control: public, max-age=31536000, immutable

# Logo files are also linked without a version (404 page, OG/JSON-LD): keep a short cache.
/brand/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=86400

/api/*
  Cache-Control: no-store
